# ~/bin/hm-switch: `home-manager switch` of this repository's configuration,
# the same way with a system nix and with nix-portable.
#
# Under nix-portable, /nix/store exists only inside its wrap, so the switch
# enters it first (unless the shell is already inside), with nix-portable's
# own bundled nix first on PATH: a newer nix from the store writes a cache
# schema the bundled one cannot read.
#
# ~/bin/np-shell is the companion: an interactive shell inside the wrap,
# where everything in ~/.nix-profile/bin runs.
{ config, lib, ... }:
let
  cfg = config.programs.hmSwitch;
  wrap = ''
    if [ -d /nix/store ]; then
      run=(/usr/bin/env bash -c)
    elif [ -x "$HOME/bin/nix-portable" ]; then
      run=(env NIX_PORTABLE_SHELL=1 "$HOME/bin/nix-portable" debug /usr/bin/env bash -c)
    else
      echo "no /nix/store and no ~/bin/nix-portable -- run bootstrap/install.sh first" >&2
      exit 1
    fi
  '';
in {
  options.programs.hmSwitch = {
    enable = lib.mkEnableOption "~/bin/hm-switch and ~/bin/np-shell";
    repoDir = lib.mkOption {
      type = lib.types.str;
      example = "$HOME/slurm-gpu-for-gitlab-ci";
      description = "The checkout to switch from (a shell word; $HOME expands).";
    };
    flakeAttr = lib.mkOption {
      type = lib.types.str;
      example = "slurm-frontend";
      description = "The homeConfigurations attribute to switch to.";
    };
    nixGlob = lib.mkOption {
      type = lib.types.str;
      default = "*-nix-2.20.*";
      description = ''
        Under nix-portable: the /nix/store glob of its bundled nix (2.20 for
        nix-portable v012), put first on PATH.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    home.file."bin/hm-switch" = {
      executable = true;
      text = ''
        #!/usr/bin/env bash
        # Auto-generated by home-manager (hm-switch module); do not edit.
        set -euo pipefail
        ${wrap}
        export SLURM_CI_REPO_DIR="''${SLURM_CI_REPO_DIR:-${cfg.repoDir}}"
        exec "''${run[@]}" '
          set -e
          if [ -n "''${NIX_PORTABLE_SHELL:-}" ]; then
            np_nix="$(ls -d /nix/store/${cfg.nixGlob}/bin 2>/dev/null | head -1)"
            export PATH="''${np_nix:+$np_nix:}$HOME/.nix-profile/bin:$PATH"
          fi
          cd "$SLURM_CI_REPO_DIR" || { echo "hm-switch: no checkout at $SLURM_CI_REPO_DIR (set SLURM_CI_REPO_DIR)" >&2; exit 1; }
          exec home-manager switch --impure --flake ".#${cfg.flakeAttr}" "$@"
        ' bash "$@"
      '';
    };
    home.file."bin/np-shell" = {
      executable = true;
      text = ''
        #!/usr/bin/env bash
        # Auto-generated by home-manager (hm-switch module); do not edit.
        # An interactive shell where /nix/store exists (nix-portable's wrap).
        set -euo pipefail
        if [ -d /nix/store ]; then exec "''${SHELL:-bash}" "$@"; fi
        exec env NIX_PORTABLE_SHELL=1 "$HOME/bin/nix-portable" debug /usr/bin/env bash "$@"
      '';
    };
  };
}
