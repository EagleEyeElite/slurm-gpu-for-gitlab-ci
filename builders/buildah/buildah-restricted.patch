+		// Populate a minimal /proc/self inside the container rootfs.
+		// Without real procfs, tools like uv need /proc/self/maps to
+		// detect glibc. Best-effort: ignore errors.
+		_ = os.MkdirAll("/proc/self", 0o555)
+		// Create /proc/self/maps with a libc entry so tools can detect glibc.
+		if libcPath, err := filepath.EvalSymlinks("/lib/x86_64-linux-gnu/libc.so.6"); err == nil {
+			_ = os.WriteFile("/proc/self/maps", []byte(
+				"7f0000000000-7f0000200000 r-xp 00000000 00:00 0                          "+libcPath+"\n"), 0o444)
+		} else if libcPath, err = filepath.EvalSymlinks("/lib64/libc.so.6"); err == nil {
+			_ = os.WriteFile("/proc/self/maps", []byte(
+				"7f0000000000-7f0000200000 r-xp 00000000 00:00 0                          "+libcPath+"\n"), 0o444)
+		}
+		// Provide /dev/null if missing (many tools need it).
+		if _, err := os.Stat("/dev/null"); err != nil {
+			_ = os.MkdirAll("/dev", 0o755)
+			_ = unix.Mknod("/dev/null", 0o666|unix.S_IFCHR, int(unix.Mkdev(1, 3)))
+			_ = unix.Mknod("/dev/zero", 0o666|unix.S_IFCHR, int(unix.Mkdev(1, 5)))
+			_ = unix.Mknod("/dev/urandom", 0o666|unix.S_IFCHR, int(unix.Mkdev(1, 9)))
+		}
 	}
 
